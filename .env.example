# Postgres. DIRECT_URL is only needed when DATABASE_URL points at a pooler.
DATABASE_URL="postgresql://user:pass@localhost:5432/pbha_alumni"
DIRECT_URL="postgresql://user:pass@localhost:5432/pbha_alumni"

NODE_ENV=development
PORT=4000
PUBLIC_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:4000"

# At least 32 random chars in production: `openssl rand -base64 32`
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_COST=12

# Optional invite-code gate on signup. Blank means open signup.
SIGNUP_SECRET_CODE=""
